<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEDxGIIS Youth</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
        body, html{
            margin:0;
            padding:0;
            color:#ffffff;
            background-color:#000000;
            font-family:'DM Sans', sans-serif;
            font-weight:400;
            line-height:1.6;
            letter-spacing:0.3px;
        }
        h1, h2, h3{
            font-family:'Inter', sans-serif;
            font-weight:700;
            letter-spacing:0.5px;
            margin:0;
        }
        h1{
            font-size:clamp(2.2em, 5.4vw, 3.8em);
            line-height:1;
        }
        h2{
            font-size:clamp(1.65em, 3.2vw, 2.8em);
            line-height:1;
            margin:0;
        }
        p{
            font-size:clamp(1.06em, 1.35vw, 1.2em);
            font-weight:400;
            letter-spacing:0.2px;
            line-height:1.2;
        }
        .nav{
            background-color:#00000085;
            backdrop-filter:blur(10px);
            -webkit-backdrop-filter: blur(10px);
            width:100%;
            height:3.4em;
            border-radius:0 0 1em 1em;
            font-size:clamp(0.98em, 1.2vw, 1.08em);
            font-weight:600;
            padding-right:1.5em;
            box-sizing:border-box;
            position:fixed;
            top:0;
            z-index:100;
            text-align:center;
            
        }

        #logopng{
            height:3em;
        }
        .footer-logo{
            height:auto;
        }

        .content{
            padding:0.9em;
            box-sizing:border-box;
            display:flex;
            flex-direction:column;
            margin: 4.8em auto 0;
            max-width:980px;
            gap:1.8em;
        }
        
        /* SCROLLBAR styling */
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #353535;
        }
        ::-webkit-scrollbar-thumb {
            background: #EB0028;
            border-radius:5px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #eb0062;
        }

        footer{
            display:flex;
            justify-content:space-between;
            flex-direction:row;
            align-items:center;
            padding:1em;
            box-sizing:border-box;
            width:100%;
        }
        .left{
            display:flex;
            flex-direction:column;
            width:30%;
        }
        .right{
            display:flex;
            flex-direction:column;
            width:70%;
            height:100%;
            align-items:flex-end;
        }
        footer p{
            margin:0;
        }
        hr{
            border:0;
            height:1.5px;
            background-color:#EB0028;
            margin:0;
            width:100%;
            align-self:center;
        }
        h1{
            line-height:0.8;
        }
    </style>

</head>
<body>
    <div class="nav">
        <img src="/resources/logo-white.png" alt="TEDxGIIS Logo" id="logopng">
    </div>
    <div class="content">
    </div>
    
    <hr>
    <footer>
        <div class="left">
            <img src="/resources/logo-white.png" alt="TEDxGIIS Logo" class="footer-logo" >
        </div>
        <div class="right">            
            <p>27 Punggol Field Walk, Singapore 828649</p>
            <p>© 2024 TEDxGIIS Youth. All rights reserved.</p>
            <p>This independent TEDx event is operated under licence from TED</p>
        </div>
    </footer>
</body>
</html>