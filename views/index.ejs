<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEDxGIIS Youth</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
        body, html{
            margin:0;
            padding:0;
            color:#ffffff;
            background-color:#000000;
            font-family:'Inter', sans-serif;
            font-weight:400;
            line-height:1.6;
            letter-spacing:0.3px;
        }
        h1, h2, h3{
            font-family:'DM Sans', sans-serif;
            font-weight:700;
            letter-spacing:0.5px;
            margin:0;
        }
        h1{
            font-size:clamp(2em, 5vw, 3.5em);
            line-height:1.2;
        }
        h2{
            font-size:clamp(1.5em, 3vw, 2.5em);
            line-height:1.3;
        }
        p{
            font-size:clamp(0.95em, 1.2vw, 1.1em);
            font-weight:400;
            letter-spacing:0.2px;
            line-height:1.8;
        }
        .nav{
            background-color:#000000d2;
            backdrop-filter:blur(10px);
            -webkit-backdrop-filter: blur(10px);
            width:100%;
            height:3em;
            display: flex;
            align-items:center;
            border-radius:0 0 1em 1em;
            font-size:clamp(0.9em, 1.1vw, 1em);
            font-weight:600;
            padding-right:1.5em;
            box-sizing:border-box;
            position:fixed;
            top:0;
            z-index:100;
        }

        #logopng{
            height:3em;
        }
        .ciclk{
            color:#ffffff;
            text-decoration:none;
            height:auto;
            display:inline-flex;
            align-items:center;
            padding:0.75rem 1.25rem;
            box-sizing:border-box;
            position:relative;
            font-weight:600;
            font-size:inherit;
            letter-spacing:0.4px;
            transition:color 180ms ease;
        }
        .ciclk:focus-visible{
            outline:2px solid #EB0028;
            outline-offset:2px;
        }

        .ciclk::before{
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 5px;
            background: transparent;
            transform-origin: left;
            transform: scaleX(0);
            transition: transform 180ms ease, background-color 180ms ease;
        }

        .ciclk:hover::before{
            background: #EB0028;
            transform: scaleX(1);
        }
        .nav-right{
            margin-left:auto;
            display:flex;
            gap:0.5rem;
            align-items:center;
        }
        .content{
            padding:0.5em;
            box-sizing:border-box;
            display:flex;
            flex-direction:column;
            margin-top:4em;
            max-width:900px;
            gap:1.5em;
        }
        
        .hero{
            box-sizing:border-box;
            display:flex;
            flex-wrap:wrap;
            margin-top:3em;
        }

        /* SCROLLBAR styling */
            ::-webkit-scrollbar {
            width: 5px;
            }
            ::-webkit-scrollbar-track {
            background: #353535;
            }
            ::-webkit-scrollbar-thumb {
            background: #EB0028;
            border-radius:5px;
            }
            ::-webkit-scrollbar-thumb:hover {
            background: #eb0062;
            }
    </style>

</head>
<body>
    <div class="nav">
        <img src="resources/logo-white.png" alt="TEDxGIIS Youth logo" id="logopng">
        <div class="nav-right">
            <a href="/" class="ciclk">Home</a>
            <a href="/speakers" class="ciclk">Speakers</a>
            <a href="/team" class="ciclk">Team</a>
            <a href="/account" class="ciclk"><%= locals.user ? locals.user.name : 'Account' %></a>
        </div>
    </div>
    <div class="hero">
    </div>
    <div class="content">
        <h1>Welcome to TEDxGIIS Youth</h1>
        <p>Discover inspiring talks, innovative ideas, and a vibrant community of thinkers and doers. Join us on a journey of exploration and creativity as we share stories that matter.</p>
    </div>
</body>
</html>