<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEDxGIIS Youth</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
        body, html{
            margin:0;
            padding:0;
            color:#ffffff;
            background-color:#000000;
            font-family:'DM Sans', sans-serif;
            font-weight:400;
            line-height:1.6;
            letter-spacing:0.3px;
        }
        h1, h2, h3{
            font-family:'Inter', sans-serif;
            font-weight:800;
            letter-spacing:-0.5px;
            margin:0;
            color:#ffffff;
        }
        h1{
            font-size:clamp(2.2em, 5.4vw, 3.8em);
            line-height:1;
        }
        h2{
            font-size:clamp(1.65em, 3.2vw, 2.8em);
            line-height:1;
            margin:0;
        }
        p{
            font-size:clamp(1.06em, 1.35vw, 1.2em);
            font-weight:400;
            letter-spacing:0.2px;
            line-height:1.6;
            color:#e4e4e4;
        }
        .nav{
            background-color:rgba(0, 0, 0, 0.85);
            backdrop-filter:blur(10px);
            -webkit-backdrop-filter: blur(10px);
            width:100%;
            height:3.8em;
            display: flex;
            align-items:center;
            border-bottom:1px solid rgba(255, 255, 255, 0.08);
            font-size:clamp(0.98em, 1.2vw, 1.08em);
            font-weight:600;
            padding-right:1.5em;
            box-sizing:border-box;
            position:fixed;
            top:0;
            z-index:100;
        }

        #logopng{
            height:2.6em;
            margin-left: 1em;
        }
        .footer-logo{
            height:2.2em;
        }

        .ciclk{
            color:#ffffff;
            text-decoration:none;
            height:auto;
            display:inline-flex;
            align-items:center;
            padding:0.75rem 1.25rem;
            box-sizing:border-box;
            position:relative;
            font-weight:600;
            font-size:inherit;
            letter-spacing:0.4px;
            transition:color 180ms ease;
        }
        .ciclk:focus-visible{
            outline:2px solid #EB0028;
            outline-offset:2px;
        }

        .ciclk::before{
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 4px;
            background: transparent;
            transform-origin: left;
            transform: scaleX(0);
            transition: transform 180ms ease, background-color 180ms ease;
        }

        .ciclk:hover::before{
            background: #EB0028;
            transform: scaleX(1);
        }
        .nav-right{
            margin-left:auto;
            display:flex;
            gap:0.5rem;
            align-items:center;
        }
        .content{
            padding:1.5em 0.9em;
            box-sizing:border-box;
            display:flex;
            flex-direction:column;
            margin: 4.8em auto 0;
            max-width:980px;
            gap:2.5em;
        }

        /* SCROLLBAR styling */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1a1a1a;
        }
        ::-webkit-scrollbar-thumb {
            background: #EB0028;
            border-radius:4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #b8001f;
        }

        hr{
            border:0;
            height:1px;
            background-color:#EB0028;
            margin:2em 0;
            width:100%;
        }
        h1{
            line-height:0.9;
        }

        .hero{
            box-sizing:border-box;
            margin-top:3.8em;
            width:100%;
            height:calc(85vh - 3.8em);
            background-image: url('/resources/ikigai.jpg');
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            text-align: center;
            color:#ffffff;
            display:flex;
            flex-direction:column;
            align-items:center;
            justify-content:center;
            padding: 2em;
            position:relative;
        }
        .hero h1{
            font-size:clamp(3.5em, 8vw, 6.5em);
            text-shadow:0 10px 30px rgba(0,0,0,0.85);
            position:relative;
            z-index:1;
            color: #ffffff;
            font-weight: 900;
            letter-spacing: -2px;
            line-height: 1;
        }
        .hero p{
            font-size:clamp(1.2em, 2vw, 1.8em);
            color:#e4e4e4;
            text-shadow:0 4px 15px rgba(0,0,0,0.8);
            margin-top:0.8em;
            position:relative;
            z-index:1;
            letter-spacing:1px;
            font-weight: 500;
        }

        footer {
            background-color: #111111;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding: 4em 5% 2em;
            display: flex;
            flex-direction: column;
            gap: 2em;
        }

        .footer-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 2em;
        }

        .footer-logo {
            margin-bottom: 1em;
        }

        .footer-info p {
            font-size: 0.9em;
            color: #888888;
            margin-bottom: 0.5em;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 2em;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8em;
            color: #666666;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .hero {
            animation: fadeUp 1s ease-out;
        }

        .content > * {
            animation: fadeUp 0.8s ease-out forwards;
            opacity: 0;
        }
        .content > *:nth-child(1) { animation-delay: 0.1s; }
        .content > *:nth-child(2) { animation-delay: 0.2s; }
        .content > *:nth-child(3) { animation-delay: 0.3s; }
        .content > *:nth-child(4) { animation-delay: 0.4s; }
        .content > *:nth-child(5) { animation-delay: 0.5s; }
        .content > *:nth-child(6) { animation-delay: 0.6s; }

        /* Why Attend Section */
        .why-attend, .location-section {
            margin-top: 3em;
        }
        
        .reasons-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.8em;
            margin-top: 1.8em;
        }
        
        .reason-card {
            background: linear-gradient(145deg, #1a1a1a, #0a0a0a);
            border: 1px solid #333333;
            border-radius: 14px;
            padding: 2.2em;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }
        
        .reason-card:hover {
            border-color: #EB0028;
            box-shadow: 0 10px 30px rgba(235, 0, 40, 0.15);
        }
        
        .reason-card h3 {
            color: #EB0028;
            margin-bottom: 0.6em;
            font-size: 1.35em;
            font-weight: 800;
        }
        
        .reason-card p {
            font-size: 0.98em;
            color: #cccccc;
            line-height: 1.5;
            margin: 0;
        }

        /* Location Section */
        .location-area {
            margin-top: 1.5em;
            width: 100%;
            height: 400px;
            background: linear-gradient(45deg, #111, #222);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px dashed #444444;
            color: #888888;
            font-size: 1.2em;
            position: relative;
            overflow: hidden;
            transition: border-color 0.3s ease, background-color 0.3s ease;
        }
        
        .location-area:hover {
            border-color: #EB0028;
            background-color: #1a1a1a;
        }
        
        .location-text {
            margin-top: 1em;
            font-size: 1.2em;
            color: #ffffff;
            font-weight: 600;
        }

        @media (max-width: 768px) {
            .nav-right {
                display: none; 
            }
            .content {
                padding: 4em 5%;
            }
            .footer-top {
                flex-direction: column;
            }
            .hold {
                flex-direction: column;
            }
            .maina {
                width:100%;
                border-left:none;
                border-top:4px solid #EB0028;
                padding-left:0;
                padding-top:1em;
            }
            .img {
                width:100%;
                max-height:none;
                border-radius:12px;
            }
        }
        .maina{
            display:flex;
            border-left:4px solid #EB0028;
            padding-left:1em;
            font-size:clamp(1.16em, 1.35vw, 1.25em);
            width:60%;
            align-items:center;
            flex:1;
        }
        .hold{
            display:flex;
            gap:1.5em;
            width:100%;
            align-items:center;
            background-image: linear-gradient(rgba(0, 0, 0, 0.884), rgba(0, 0, 0, 0.897)), url('/resources/ted.png');
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            background-color: rgba(0, 0, 0, 0.95);
            border-radius: 18px;
            padding: 1.5em 1.25em;
            box-sizing: border-box;
            border: 1px solid rgba(255,255,255,0.06);
        }
        .img{
            width:min(100%, 380px);
            height:auto;
            max-height:260px;
            object-fit:contain;
            border-radius:16px;
            background:linear-gradient(145deg, #1c1c1c, #090909);
            border:1px solid rgba(255,255,255,0.08);
            box-shadow:0 10px 30px rgba(0,0,0,0.22);
            padding:0.9rem;
            box-sizing:border-box;
            flex-shrink:0;
        }
        .location-area iframe{
            width:100%;
            height:100%;
            border:0;
            display:block;
        }
        img{
            border-radius: 16px;
        }
    </style>

</head>
<body>
    <div class="nav">
        <img src="/resources/logo-white.png" alt="TEDxGIIS Logo" id="logopng">
        <div class="nav-right">
            <a href="/" class="ciclk">Home</a><!-- 
            <a href="/speakers" class="ciclk">Speakers</a>
            <a href="/team" class="ciclk">Team</a>
            <a href="/account" class="ciclk"><%= locals.user ? locals.user.name : 'Account' %></a> -->
        </div>
    </div>
    <div class="hero">
        <h1>Ikigai</h1>
        <p>A reason for being</p>
    </div>
    <div class="content" >
        <h1>TED<sup>x</sup>GIIS Youth</h1>
        <div class="hold" style="background-image: linear-gradient(rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.78)), url('/resources/giistedx.jpg');">
        <div class="maina">
            <p>In the spirit of ideas worth spreading, TED has created a program called TEDx, where the x stands for independently organized TED event. TEDx is a program of local, self-organized events that bring people together to share a TED-like experience. Our event is called TEDxGIIS Youth, the event is being organized by students of the GIIS Smart Campus . At TEDxGIIS Youth, TED Talks video and live speakers will combine to spark deep discussion and connection in a small group. The TED Conference provides general guidance for the TEDx program, but individual TEDx events, including ours, are self-organized.</p>
        
        </div>
        </div>
        <h1>About TED</h1>
        <div class="hold">
            <div class="maina">
                <p>
                    TED is a nonprofit organization devoted to Ideas Worth Spreading. Started as a four-day conference in California 30 years ago, TED has grown to support its mission with multiple initiatives. The two annual TED Conferences invite the world's leading thinkers and doers to speak for 18 minutes or less. Many of these talks are then made available, free, at TED.com.
                    <br><br>
                    The annual TED Conference takes place each spring in Vancouver, British Columbia. TED's media initiatives include TED.com, where new TED Talks are posted daily. TEDx, which supports individuals or groups in hosting local, self- organized TED-style events around the world.
                </p>
            </div>
        </div>

        <div class="why-attend">
            <h1>Why Should You Attend?</h1>
            <div class="reasons-grid">
                <div class="reason-card">
                    <h3>Inspiring Talks</h3>
                    <p>Listen to diverse voices sharing powerful ideas that can spark deep discussions and new perspectives.</p>
                </div>
                <div class="reason-card">
                    <h3>Networking</h3>
                    <p>Connect with like-minded individuals, innovators, and leaders from various fields.</p>
                </div>
                <div class="reason-card">
                    <h3>Personal Growth</h3>
                    <p>Discover your own ikigai and get motivated to take action in your community.</p>
                </div>
            </div>
        </div>

        <div class="location-section">
            <h1>Location</h1>
            <p class="location-text">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#EB0028" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                27 Punggol Field Walk, Singapore 828649
            </p>
            <div class="location-area">
                <iframe
                    src="https://www.google.com/maps?q=27+Punggol+Field+Walk,+Singapore+828649&output=embed"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Map showing 27 Punggol Field Walk, Singapore 828649">
                </iframe>
            </div>
        </div>
    </div>

    <hr>

    <footer>
        <div class="footer-top">
            <div class="footer-info">
                <img src="/resources/logo-white.png" alt="TEDxGIIS Logo" class="footer-logo" >
                <p>27 Punggol Field Walk</p>
                <p>Singapore 828649</p>
            </div>
            <div class="footer-info">
                <p style="color:var(--ted-white); font-weight:bold; font-family:'Inter', sans-serif;">Connect with us</p>
                <p>Stay updated with our latest events and speakers.</p>
            </div>
        </div>
        <div class="footer-bottom">            
            <p>© 2026 TEDxGIIS Youth. All rights reserved.</p>
            <p>This independent TEDx event is operated under licence from TED.</p>
        </div>
    </footer>
</body>
</html>
