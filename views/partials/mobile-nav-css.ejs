        .mobile-menu-toggle {
            display: none;
            margin-left: auto;
            border: 1px solid rgba(255,255,255,.22);
            background: transparent;
            color: #fff;
            border-radius: 8px;
            width: 2.4rem;
            height: 2.4rem;
            font-size: 1.3rem;
            line-height: 1;
            cursor: pointer;
        }
        .mobile-nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.58);
            z-index: 150;
        }
        .mobile-sidebar {
            position: fixed;
            top: 0;
            right: 0;
            height: 100dvh;
            width: min(82vw, 320px);
            background: #0b0b0b;
            border-left: 1px solid rgba(255,255,255,.12);
            z-index: 160;
            transform: translateX(100%);
            transition: transform .2s ease;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .mobile-sidebar.open { transform: translateX(0); }
        .mobile-sidebar-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            font-weight: 700;
        }
        .mobile-menu-close {
            border: 1px solid rgba(255,255,255,.22);
            background: transparent;
            color: #fff;
            border-radius: 8px;
            width: 2.2rem;
            height: 2.2rem;
            font-size: 1.35rem;
            line-height: 1;
            cursor: pointer;
        }
        .mobile-sidebar-links {
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }
        .mobile-sidebar-links a {
            color: #fff;
            text-decoration: none;
            padding: .8rem .6rem;
            border-radius: 8px;
            font-weight: 600;
        }
        .mobile-sidebar-links a.active,
        .mobile-sidebar-links a:hover {
            background: rgba(235, 0, 40, .18);
        }
        @media (max-width: 768px) {
            .mobile-menu-toggle { display: inline-flex; align-items: center; justify-content: center; }
            .nav-right { display: none !important; }
        }
