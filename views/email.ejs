<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEDx GIIS Youth</title>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "TEDx GIIS",
      "alternateName": ["TEDxGIIS", "TEDx GIIS Youth", "TEDxGIIS App", "TEDxGIIS"],
      "url": "https://tedxgiis.app",
      "applicationCategory": "EventApplication",
      "description": "Official web application for TEDx GIIS Youth events, talks, and schedule."
    }
    </script>
    
    <link rel="icon" type="image/png" href="/favicon.png">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,300..800;1,300..800&display=swap');
        
        
        :root {
            --ted-red: #e62b1e;
            --ink: #111111;
            --black: #000000;
            --muted: #b5b5b5;
            --paper: #ffffff;
            --panel-strong: #1a1a1a;
            --panel-alt: #151515;
            --red: #EB0028;
            --red-dark: #b8001f;
            --muted: #d7d7d7;
            --soft: #8e8e8e;
            --line: rgba(255,255,255,.08);
            --text: #ffffff;
            --content-width: 1180px;
        }

        body,html{
            margin: 0;
            padding: 3.5em 0 0;
            font-family: 'Host Grotesk', sans-serif;
            background-color: var(--black);
            color: var(--paper);
            min-height: 100%;
            overflow-x: hidden;
        }
        nav{
            position: fixed;
            top:0;
            width: 100%;
            box-sizing: border-box;
            display:flex;
            gap:0.3rem;
            font-size: 1.1rem;
            padding: 0.1rem 0.3rem;
            align-items:center;
            background: linear-gradient(45deg, #180606e7 0%, #0f1015e7 100%);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(10px);
            height:3.5em;
            -webkit-backdrop-filter: blur(10px);
            margin-bottom:1em;
            padding: 0.1rem clamp(1rem, 4vw, 3rem);
            z-index: 10;
        }
        .left{
            margin-right: auto;
        }
        .left img{
            display: block;
            height: 3.25em;
            width: auto;
        }
        a{
            color: var(--paper);
            text-decoration: none;

        }
        nav > div:not(.left) a{
            display: block;
            padding: 0 0.75rem;
            text-align: center;
        }
        
        h1, h2, h3{
            font-family:'Host Grotesk', sans-serif;
            font-weight:800;
            letter-spacing:0;
            margin:0;
            color:var(--text);
        }
        h1{
            font-size:clamp(2.2rem, 5.4vw, 4.8rem);
            line-height:0.95;
        }
        h2{
            font-size:clamp(1.65em, 3.2vw, 2.8em);
            line-height:1;
            margin:0;
        }
        p{
            font-size:clamp(1rem, 1.35vw, 1.15rem);
            font-weight:400;
            letter-spacing:0.2px;
            line-height:1.6;
            color:var(--muted);
        }

        .content{
            width:min(calc(100% - 2rem), var(--content-width));
            margin:0 auto;
            padding:clamp(2rem, 6vw, 5rem) 0 2rem;
        }

        .content > h1{
            margin-bottom:clamp(1.5rem, 4vw, 3rem);
        }

        .story-section{
            position:relative;
            margin-bottom:clamp(4rem, 8vw, 7rem);
        }
        .story-heading{
            margin-bottom:1.25rem;
            border-top:1px solid var(--line);
            padding-top:1.25rem;
        }
        .story-section .hold{
            margin-bottom:0;
        }
        .youth-story,
        .about-story{
            max-width:900px;
            margin-left:auto;
        }
        .youth-story .hold,
        .about-story .hold{
            max-width:780px;
            margin-left:0;
            padding:0 0 0 1.5rem;
            background:none !important;
            border:0;
            border-left:3px solid var(--red);
            border-radius:0;
        }
        .youth-story .maina,
        .about-story .maina{
            padding:0;
        }
        .youth-story p,
        .about-story p{
            margin:0;
            color:#c8c8c8;
            font-size:clamp(1rem, 1.5vw, 1.2rem);
            line-height:1.75;
        }
        
        .ciclk{
            color:var(--text);
            text-decoration:none;
            height:auto;
            display:inline-flex;
            align-items:center;
            padding:0.75rem 1.25rem;
            box-sizing:border-box;
            position:relative;
            font-weight:600;
            font-size:inherit;
            letter-spacing:0.4px;
            transition:color 180ms ease;
        }
        .ciclk:focus-visible{
            outline:3px solid #EB0028;
            outline-offset:5px;
        }

        .ciclk::before{
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            background: transparent;
            transform-origin: left;
            transform: scaleX(0);
            transition: transform 180ms ease, background-color 180ms ease;
        }

        .ciclk:hover::before{
            background: var(--red);
            transform: scaleX(1);
        }
        .footer{
            position: relative;
            font-family: 'Host Grotesk', sans-serif;
            margin-top:clamp(4rem, 9vw, 8rem);
            padding:clamp(2.5rem, 6vw, 4.5rem) max(1.25rem, 5vw) 0;
            text-align:center;
            background:linear-gradient(180deg, #111111 0%, #080808 100%);
            border-top:1px solid var(--line);
            overflow:hidden;
        }
        .logon{
            display: block;
            width:min(100%, 360px);
            margin:0 auto 1.5rem;
            height:auto;
        }
        hr{
            border: none;
            border-top:1px solid var(--line);
            margin:0 auto 1.5rem;
            width:min(100%, var(--content-width));
        }
        .footer-links{
            display:flex;
            justify-content:center;
            flex-wrap:wrap;
            gap:0.35rem 1.5rem;
            margin-bottom:1.25rem;
        }
        .footer-links a{
            color:var(--muted);
            font-size:0.9rem;
            font-weight:600;
            letter-spacing:0.05em;
            text-transform:uppercase;
            transition:color 180ms ease;
        }
        .footer-links a:hover,
        .footer-links a:focus-visible{
            color:var(--red);
        }
        .footer-meta{
            position:relative;
            z-index:1;
            margin:0 auto;
            color:var(--soft);
            font-size:0.82rem;
            line-height:1.5;
        }
        .red-dip{
            position:relative;
            left:50%;
            width:100vw;
            height:clamp(2.5rem, 6vw, 5rem);
            margin-top:1.5rem;
            transform:translateX(-50%);
            background:var(--red-dark);
            border-radius:50% 50% 0 0 / 35% 35% 0 0;
        }
        
        .maina {
            width:100%;
            border-left:none;
            padding-left:0;
            padding-top:1em;
        }
        .hold{
            width:100%;
            margin-bottom:1.5rem;
            background-image: linear-gradient(rgba(0, 0, 0, 0.884), rgba(0, 0, 0, 0.897)), url('resources/ted.png');
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            background-color: rgba(0, 0, 0, 0.95);
            border-radius: 18px;
            padding:clamp(1.25rem, 3vw, 2.5rem);
            box-sizing: border-box;
            border: 1px solid rgba(255,255,255,0.06);
            border-top: 4px solid var(--red);
        }
        .img{
            width:min(100%, 380px);
            height:auto;
            max-height:260px;
            object-fit:contain;
            border-radius:16px;
            background:linear-gradient(145deg, #1c1c1c, #090909);
            border:1px solid rgba(255,255,255,0.08);
            box-shadow:0 10px 30px rgba(0,0,0,0.22);
            padding:0.9rem;
            box-sizing:border-box;
            flex-shrink:0;
        }

        .maina{
            padding-top:1rem;
        }

        .location-section{
            display:grid;
            grid-template-columns:minmax(0, 0.8fr) minmax(0, 1.2fr);
            gap:2rem;
            align-items:start;
            margin-top:clamp(3rem, 8vw, 7rem);
            padding-top:2rem;
            border-top:1px solid var(--line);
        }

        .location-section h1{
            grid-column:1;
        }
        .location-text{
            grid-column:1; margin:0;
        }
        .location-area{
            grid-column:2; grid-row:1 / span 2;
        }
        .location-area iframe{
            display:block;
            width:100%;
            min-height:320px;
            border:0;
            border-radius:12px;
        }

        @media (max-width:700px){
            nav{ gap:0; }
            nav .left{
                min-width:0;
            }
            nav > div:not(.left) a{
                padding:0 0.4rem; font-size:0.85rem;
            }
            .left img{
                width:min(42vw, 170px); height:auto; max-height:2.75em; object-fit:contain;
            }
            .content{
                width:min(calc(100% - 1.25rem), var(--content-width)); padding-top:2.5rem;
            }
            .hold{
                border-radius:12px;
            }
            .story-heading h1{
                font-size:clamp(2rem, 12vw, 3.2rem); 
            }
            .about-story{
                padding-left:0; 
            }
            
            .youth-story .hold,.about-story .hold{
                padding-left:1rem;
            }
            .location-section{
                display:block;
            }
            .location-text{
                margin:1rem 0 1.5rem;
            }
            .location-area iframe{
                min-height:260px;
            }
        }
        #read{
            width:min(100%, 520px);
            margin:1.5rem auto 0;
            padding:1rem;
            box-sizing:border-box;
            background:linear-gradient(145deg, #1a1a1a, #090909);
            border:1px solid var(--line);
            border-top:3px solid var(--red);
            border-radius:12px;
            box-shadow:0 18px 45px rgba(0,0,0,.28);
        }
        #read video{
            display:block;
            width:100% !important;
            height:auto !important;
            border-radius:8px;
        }
        #read video{
            transform:scaleX(-1);
        }
        .content{
            text-align:center;
            width:min(calc(100% - 2rem), var(--content-width));
        }
        .content > h1{
            margin:0;
            font-size:clamp(2rem, 5vw, 4rem);
        }
        .status-panel{
            display:none;
            width:min(100%, 760px);
            min-height:10em;
            margin:0 auto 1.5rem;
            padding:clamp(1.5rem, 4vw, 2.5rem);
            box-sizing:border-box;
            align-items:center;
            justify-content:center;
            border-radius:12px;
            border:1px solid var(--line);
        }
        .status-panel.is-visible{
            display:flex;
            flex-direction:column;
        }
        .welcome{
            line-height:1;
            background:linear-gradient(180deg, #012500, #090909);
            animation:verif 1.2s ease 1 forwards;

        }
        @keyframes verif{
            0%{
                background:linear-gradient(180deg, #000000, #090909);
            }
            6.666%{
                background:linear-gradient(180deg, #020700, #070707);
            }
            13.333%{
                background:linear-gradient(180deg, #040e00, #050505);
            }
            20%{
                background:linear-gradient(180deg, #061200, #030303);
            }
            26.666%{
                background:linear-gradient(180deg, #081500, #010101);
            }
            33.333%{
                background:linear-gradient(180deg, #001800, #000000);
            }
            40%{
                background:linear-gradient(180deg, #001c00, #000000);
            }
            46.666%{
                background:linear-gradient(180deg, #001f00, #000000);
            }
            53.333%{
                background:linear-gradient(180deg, #002900, #000000);
            }
            60%{
                background:linear-gradient(180deg, #003b0d, #000000);
            }
            66.666%{
                background:linear-gradient(180deg, #004b11, #000000);
            }
            73.333%{
                background:linear-gradient(180deg, #005a16, #000000);
            }
            80%{
                background:linear-gradient(180deg, #006619, #000000);
            }
            86.666%{
                background:linear-gradient(180deg, #00751d, #000000);
            }
            93.333%{
                background:linear-gradient(180deg, #007e20, #000000);
            }
            100%{
                background:linear-gradient(180deg, #008622, #000000);
            }
        }

         .rejec{
            line-height:1;
            background:linear-gradient(180deg, #250000, #090909);
            animation:decl 1.2s ease 1 forwards;

        }
        @keyframes decl{
            0%{
                background:linear-gradient(180deg, #000000, #090909);
            }
            6.666%{
                background:linear-gradient(180deg, #070000, #070707);
            }
            13.333%{
                background:linear-gradient(180deg, #0e0000, #050505);
            }
            20%{
                background:linear-gradient(180deg, #120000, #030303);
            }
            26.666%{
                background:linear-gradient(180deg, #150000, #010101);
            }
            33.333%{
                background:linear-gradient(180deg, #180000, #000000);
            }
            40%{
                background:linear-gradient(180deg, #1c0000, #000000);
            }
            46.666%{
                background:linear-gradient(180deg, #1f0000, #000000);
            }
            53.333%{
                background:linear-gradient(180deg, #290000, #000000);
            }
            60%{
                background:linear-gradient(180deg, #3b0000, #000000);
            }
            66.666%{
                background:linear-gradient(180deg, #4b0000, #000000);
            }
            73.333%{
                background:linear-gradient(180deg, #5a0000, #000000);
            }
            80%{
                background:linear-gradient(180deg, #660000, #000000);
            }
            86.666%{
                background:linear-gradient(180deg, #750000, #000000);
            }
            93.333%{
                background:linear-gradient(180deg, #7e0000, #000000);
            }
            100%{
                background:linear-gradient(180deg, #860000, #000000);
            }
        }
        .welcome p{
            font-size:clamp(0.9rem, 1.5vw, 1.1rem);
            color:var(--muted);
            margin-top:0.2em;
        }
    </style>
</head>
<body>
    <nav>
        <div class="left"><a href="" class="nav"><img src="resources/logow.png"></a></div>
        <div><a href="/QR" class="nav ciclk">QR Scanning</a></div>
        <div><a href="/email" class="nav ciclk">Emailer</a></div>
        <div><a href="/signem" class="nav ciclk">SignUp Participants</a></div>
    </nav>
    

    <div class="footer">
        <hr>
        <img src="resources/bottom.png" alt="TEDxGIIS Youth" class="logon">
        <div class="footer-links" aria-label="Footer navigation">
            <a href="/">Home</a>
            <a href="/QR">QR Scanning</a>
            <a href="/email">Emailer</a>
            <a href="/signem">SignUp Participants</a>
        </div>
        <p class="footer-meta">TEDxGIIS Youth | Ideas worth spreading</p>
        <div class="red-dip"></div>
        
    </div>
</body>
</html>