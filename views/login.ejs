<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEDxGIIS Youth</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
        body, html{
            margin:0;
            padding:0;
            color:#ffffff;
            background-color:#000000;
            font-family:'DM Sans', sans-serif;
            font-weight:400;
            line-height:1.6;
            letter-spacing:0.3px;
        }
        h1, h2, h3{
            font-family:'Inter', sans-serif;
            font-weight:700;
            letter-spacing:0.5px;
            margin:0;
        }
        h1{
            font-size:clamp(2.2em, 5.4vw, 3.8em);
            line-height:1;
        }
        h2{
            font-size:clamp(1.65em, 3.2vw, 2.8em);
            line-height:1;
            margin:0;
        }
        p{
            font-size:clamp(1.06em, 1.35vw, 1.2em);
            font-weight:400;
            letter-spacing:0.2px;
            line-height:1.2;
        }
        .nav{
            background-color:#00000085;
            backdrop-filter:blur(10px);
            -webkit-backdrop-filter: blur(10px);
            width:100%;
            height:3.4em;
            border-radius:0 0 1em 1em;
            font-size:clamp(0.98em, 1.2vw, 1.08em);
            font-weight:600;
            padding-right:1.5em;
            box-sizing:border-box;
            position:fixed;
            top:0;
            z-index:100;
            text-align:center;

        }

        #logopng{
            height:3em;
        }
        .footer-logo{
            height:auto;
        }

        .content{
            padding:0.9em;
            box-sizing:border-box;
            display:flex;
            flex-direction:column;
            margin: 4.8em auto 0;
            max-width:980px;
            gap:1.8em;
        }
    
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #353535;
        }
        ::-webkit-scrollbar-thumb {
            background: #EB0028;
            border-radius:5px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #eb0062;
        }

        footer{
            display:flex;
            justify-content:space-between;
            flex-direction:row;
            align-items:center;
            padding:1em;
            box-sizing:border-box;
            width:100%;
        }
        .left{
            display:flex;
            flex-direction:column;
            width:30%;
        }
        .right{
            display:flex;
            flex-direction:column;
            width:70%;
            height:100%;
            align-items:flex-end;
        }
        footer p{
            margin:0;
        }
        hr{
            border:0;
            height:1.5px;
            background-color:#EB0028;
            margin:0;
            width:100%;
            align-self:center;
        }
        h1{
            line-height:0.8;
        }

        .login{
            display:flex;
            flex-direction:column;
            align-items:center;
            justify-content:center;
            padding:2.5em 2.2em;
            max-width:360px;
            width:100%;
            margin:3em auto 0;
            background-color:#0e0e0e;
            border:1px solid #262626;
            box-shadow:0 8px 30px rgba(0,0,0,0.55);
            border-radius:0.9em;
        }
        .login img{
            margin-bottom:1.4em;
        }
        .login form{
            display:flex;
            flex-direction:column;
            width:100%;
        }
        .login label{
            font-size:0.9em;
            font-weight:600;
            color:#cfcfcf;
            margin-bottom:0.4em;
        }

        input[type="email"], input[type="password"]{
            width:100%;
            padding:0.75em 0.9em;
            margin-bottom:1.2em;
            border-radius:0.5em;
            border:1px solid #333333;
            background-color:#1a1a1a;
            color:#ffffff;
            font-family:'DM Sans', sans-serif;
            font-size:0.98em;
            box-sizing:border-box;
            transition:border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        }
        input[type="email"]::placeholder, input[type="password"]::placeholder{
            color:#777777;
        }
        input[type="email"]:hover, input[type="password"]:hover{
            border-color:#4a4a4a;
        }
        input[type="email"]:focus, input[type="password"]:focus{
            outline:none;
            border-color:#EB0028;
            background-color:#1f1f1f;
            box-shadow:0 0 0 3px rgba(235,0,40,0.2);
        }

        button[type="submit"]{
            width:100%;
            padding:0.75em 0.9em;
            margin-top:0.3em;
            border:none;
            border-radius:0.5em;
            background-color:#EB0028;
            color:#ffffff;
            font-family:'Inter', sans-serif;
            font-weight:700;
            font-size:0.98em;
            letter-spacing:0.4px;
            cursor:pointer;
            transition:background-color 0.2s ease, transform 0.1s ease;
        }
        button[type="submit"]:hover{
            background-color:#ff1a44;
        }
        button[type="submit"]:active{
            transform:scale(0.98);
        }
    </style>

</head>
<body>
    <div class="content">
        <div class="login">
            <img src="resources/logo-white.png" alt="TEDxGIIS Youth Logo" style="height: 4em; margin-bottom: 1em;">
            <form action="/login" method="POST">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="••••••••" required>
                <button type="submit">Login</button>

            </form> 
        </div>
    </div>
    
    <hr>
    <footer>
        <div class="left">
            <img src="/resources/logo-white.png" alt="TEDxGIIS Logo" class="footer-logo" >
        </div>
        <div class="right">            
            <p>27 Punggol Field Walk, Singapore 828649</p>
            <p>© 2024 TEDxGIIS Youth. All rights reserved.</p>
            <p>This independent TEDx event is operated under licence from TED</p>
        </div>
    </footer>
</body>
</html>