<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Speakers | TEDxGIIS Youth</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
        :root {
            --bg: #000000;
            --panel: #111111;
            --panel-strong: #1a1a1a;
            --panel-alt: #151515;
            --red: #EB0028;
            --red-dark: #b8001f;
            --text: #ffffff;
            --muted: #d7d7d7;
            --soft: #8e8e8e;
            --line: rgba(255,255,255,.08);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body, html {
            margin: 0;
            padding: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            overflow-x: hidden;
        }
        h1, h2, h3 {
            font-family: 'Inter', sans-serif;
            margin: 0;
        }
        p {
            color: var(--muted);
            line-height: 1.6;
            margin: 0;
        }
        .nav {
            background: rgba(0,0,0,.85);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            width: 100%;
            min-height: 3.8em;
            display: flex;
            align-items: center;
            padding: .5em 1em;
            box-sizing: border-box;
            position: fixed;
            top: 0;
            z-index: 100;
        }
        #logopng { height: 2.6em; }
        .nav-right {
            margin-left: auto;
            display: flex;
            gap: .5rem;
            align-items: center;
            overflow-x: auto;
            max-width: 75vw;
        }
        .ciclk {
            color: #fff;
            text-decoration: none;
            padding: .7rem .95rem;
            position: relative;
            white-space: nowrap;
            font-weight: 600;
        }
        .ciclk::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 4px;
            background: transparent;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .18s ease, background-color .18s ease;
        }
        .ciclk:hover::before, .ciclk.active::before { background: #EB0028; transform: scaleX(1); }
        .page {
            max-width: 1040px;
            margin: 0 auto;
            padding: 6.2em 1.1em 2.5em;
        }
        .hero {
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 18px;
            background: linear-gradient(145deg, #151515, #090909);
            padding: 2em;
            box-shadow: 0 18px 30px rgba(0,0,0,0.2);
        }
        .hero h1 { font-size: clamp(2.1em, 5vw, 3.4em); }
        .speaker-section { margin-top: 2em; }
        .speaker-section h2 {
            margin-bottom: .9em;
            font-size: clamp(1.25em, 2vw, 1.6em);
            color: #EB0028;
        }
        .cards {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1em;
        }
        .speaker-card {
            background: linear-gradient(145deg, #1a1a1a, #0a0a0a);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 14px;
            padding: 1em;
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
            transition: transform .2s ease, border-color .2s ease;
        }
        .speaker-card:hover {
            transform: translateY(-2px);
            border-color: rgba(235, 0, 40, 0.5);
        }
        .image-placeholder {
            height: 170px;
            border: 2px dashed #4a4a4a;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9a9a9a;
            font-size: .95em;
            margin-bottom: .85em;
            text-align: center;
            padding: 0.75rem;
        }
        .speaker-name {
            color: #EB0028;
            font-size: 1.1em;
            font-weight: 700;
        }
        .speaker-meta {
            font-size: .94em;
            color: #cecece;
            margin-top: .35em;
        }
        footer {
            border-top: 1px solid rgba(255,255,255,.08);
            margin-top: 2.5em;
            padding-top: 1.2em;
            color: #8e8e8e;
            font-size: .9em;
        }
        @media (max-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 768px) {
            .nav { padding: .5em; }
            #logopng { height: 2.2em; }
            .ciclk { padding: .6rem .75rem; font-size: .92em; }
            .hero { padding: 1.4em; }
            .page { padding-left: .8rem; padding-right: .8rem; }
        }
        @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="nav">
        <img src="/resources/logo-white.png" alt="TEDxGIIS Logo" id="logopng">
        <div class="nav-right">
            <a href="/" class="ciclk">Home</a>
            <a href="/speakers" class="ciclk active">Speakers</a>
            <a href="/team" class="ciclk">Team</a>
            <a href="/registration" class="ciclk">Registration</a>
        </div>
    </div>

    <main class="page">
        <section class="hero">
            <h1>Speaker List</h1>
            <p>Meet the voices shaping TEDxGIIS Youth.</p>
        </section>

        <section class="speaker-section">
            <div class="cards">
                <article class="speaker-card"><div class="image-placeholder">Speaker Image Placeholder</div><p class="speaker-name">Speaker Name Placeholder</p><p class="speaker-meta">Topic/Title Placeholder</p></article>
                <article class="speaker-card"><div class="image-placeholder">Speaker Image Placeholder</div><p class="speaker-name">Speaker Name Placeholder</p><p class="speaker-meta">Topic/Title Placeholder</p></article>
                <article class="speaker-card"><div class="image-placeholder">Speaker Image Placeholder</div><p class="speaker-name">Speaker Name Placeholder</p><p class="speaker-meta">Topic/Title Placeholder</p></article>
                <article class="speaker-card"><div class="image-placeholder">Speaker Image Placeholder</div><p class="speaker-name">Speaker Name Placeholder</p><p class="speaker-meta">Topic/Title Placeholder</p></article>
                <article class="speaker-card"><div class="image-placeholder">Speaker Image Placeholder</div><p class="speaker-name">Speaker Name Placeholder</p><p class="speaker-meta">Topic/Title Placeholder</p></article>
                <article class="speaker-card"><div class="image-placeholder">Speaker Image Placeholder</div><p class="speaker-name">Speaker Name Placeholder</p><p class="speaker-meta">Topic/Title Placeholder</p></article>
            </div>
        </section>

        <footer>© 2026 TEDxGIIS Youth. This independent TEDx event is operated under licence from TED.</footer>
    </main>
</body>
</html>
